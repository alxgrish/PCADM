<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PCADM.Mobile.BDataPage"
             Title="Данные базы">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Выберите таблицу" FontSize="24" />
        <HorizontalStackLayout Spacing="10">
            <Button Text="Кабинеты" Clicked="Cabinets_Clicked" />
            <Button Text="ПК" Clicked="PCs_Clicked" />
            <Button Text="Проблемы" Clicked="Problems_Clicked" />
            <Button Text="Архив" Clicked="Archive_Clicked" />
        </HorizontalStackLayout>
        <CollectionView x:Name="RecordsCollection">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame CornerRadius="10" Padding="10" Margin="0,0,0,10" BackgroundColor="#F5F5F5">
                        <Label Text="{Binding display}" />
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Text="Обновить" Clicked="Refresh_Clicked" />
    </VerticalStackLayout>
</ContentPage>
