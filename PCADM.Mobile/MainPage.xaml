<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PCADM.Mobile.MainPage"
             Title="Главная">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="ПК и статусы" FontSize="24" />
            <Button Text="Принять задание" />
            <Button Text="Завершить задание" />
            <Button Text="Пинг на ПК" />
            <Button Text="Удаленный рабочий стол" Clicked="RemoteDesktop_Clicked" />
            <Button Text="Администрирование" Clicked="Admin_Clicked" />
            <Button Text="Данные базы" Clicked="BData_Clicked" />
            <Frame Padding="10" BackgroundColor="#F0F0F0" CornerRadius="15">
                <Label Text="QR код для входа" />
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
