<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PCADM.Mobile.AdminPage"
             Title="Администрирование">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Администрирование пользователей" FontSize="24" />
        <CollectionView x:Name="UsersCollection" SelectionMode="Single" SelectionChanged="UsersCollection_SelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame CornerRadius="10" Padding="10" Margin="0,0,0,10" BackgroundColor="#F5F5F5">
                        <VerticalStackLayout>
                            <Label Text="{Binding full_name}" FontAttributes="Bold" />
                            <Label Text="{Binding login}" />
                            <Label Text="{Binding role}" />
                            <Label Text="{Binding cabinet}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Text="Добавить" Clicked="AddUser_Clicked" />
        <Button Text="Обновить" Clicked="Refresh_Clicked" />
    </VerticalStackLayout>
</ContentPage>
